# AvatarK Platform — environment variable naming reference.
# Copy to .env.local and fill in real values for local dev. Never commit
# real values (`.env*` is gitignored). Preview/production values live in
# Vercel project settings, not in this repo.

# --- Supabase (this repo's own project; other AvatarK products each run
# their own separate Supabase project -- see the cross-product audit) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import it from
# client-component code -- this key bypasses Row Level Security entirely.
# Required by every Platform Admin write path (lib/supabase/admin.ts):
# organization/invitation/capability-grant management, audit logging, and
# the /admin-bootstrap first-admin grant below. Without it, those routes
# degrade to an honest 503 rather than crashing.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Grants Platform Admin (a platform_roles row) to whichever
# signed-in account's email matches this, the first time
# POST /api/admin/bootstrap is called -- see app/admin-bootstrap and
# lib/admin/authz.ts. Self-disabling: refuses once any platform_roles row
# with role='admin' exists, regardless of this var's value. Leave unset in
# any environment that already has an admin (or permanently, once one is
# granted) -- it is a one-time onboarding path, not a standing backdoor.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=

# --- Feature flags ---
NEXT_PUBLIC_ACCOUNT_MOUNT_ENABLED=true
# Google sign-in button + signInWithOAuth call are both implemented, but
# stay hidden until Supabase Auth actually has Google provider credentials
# configured (see the external configuration checklist). Leave false.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
# lib/email/sendEmail.ts refuses to send anything unless this is 'true',
# even if RESEND_API_KEY is present. Leave false until deliberately
# activated.
EMAIL_SENDING_ENABLED=false

# --- Cross-product links ---
# None of the six vars below are read by any code in this repo (confirmed
# by grep, RC1 Configuration session) -- @avatark/product-registry's own
# registry.ts is the actual, live source of truth for cross-product
# domains, not these env vars. Left here only as a documentation
# reference of what each product's real address is believed to be; do
# not assume setting one of these changes any runtime behavior.
NEXT_PUBLIC_PROMETHEUSK_URL=https://prometheusk.avatark.io
# GameK's real production domain is a genuine, unresolved ecosystem
# question, not just an unconfirmed one: the product registry and
# gamek-web's own site.config.ts say `app.avatark.ai/gamek`, but
# gamek-web's own .env.example/vercel.json target `gamek.ai/flowk`, and
# two other repos use bare `gamek.ai`. This line reflects the registry's
# current value, not a resolved fact -- see RC1_CONFIGURATION_MATRIX.md.
NEXT_PUBLIC_GAMEK_URL=https://app.avatark.ai/gamek
# Confirmed live (direct HTTP request, Wave 1) and confirmed as this
# product's real linked Vercel project (`arenak-practice`, RC1
# Configuration session) -- see RC1_CONFIGURATION_MATRIX.md.
NEXT_PUBLIC_ARENAK_URL=https://next.arenak.ai
# Confirmed live (direct HTTP request, Wave 1) at streamk.ai; this repo's
# own env template uses the bare form while StreamK's registry entry uses
# the `www.` form -- both very likely resolve, not independently confirmed
# to be the identical canonical form. See RC1_CONFIGURATION_MATRIX.md.
NEXT_PUBLIC_STREAMK_URL=https://www.streamk.ai
NEXT_PUBLIC_CINEMAK_URL=
NEXT_PUBLIC_STUDIOK_URL=
NEXT_PUBLIC_ATLAS_URL=
NEXT_PUBLIC_SETPOINTK_URL=
# Same-origin (empty) until the identity.avatark.ai hostname split happens.
# Used by lib/identity/supabaseIdentityProvider.ts to build a trusted,
# environment-aware account/sign-out URL.
NEXT_PUBLIC_PLATFORM_ORIGIN=

# --- RC5 onboarding completion receipt (see docs/RC5_HANDOFF_CONTRACT.md) ---
# Shared HMAC secret with prometheusk-web. Must differ between
# test/preview/production. Server-only.
ONBOARDING_RECEIPT_SECRET=

# --- Email / SMTP (Supabase Auth SMTP settings — configured in the
# Supabase dashboard, not read directly by this app; listed here so the
# naming stays consistent across local/test/preview/production docs and
# any future email-diagnostics surface) ---
# Resend API key used to authenticate Supabase's outbound SMTP relay.
RESEND_API_KEY=
# Branded sender identity, e.g. "AvatarK <hello@avatark.ai>". The address
# must be on a Resend-verified sending domain.
EMAIL_FROM_NAME="AvatarK"
EMAIL_FROM_ADDRESS=
